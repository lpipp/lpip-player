# Maintainer: lpipwei <https://github.com/lpipp>
pkgname=lpip-player
pkgver=0.0.1
pkgrel=1
pkgdesc="本地音乐播放器: Electron + React + MPD, 液态玻璃 UI 与高级制表机械星盘美学"
arch=('x86_64')
url="https://github.com/lpipp/lpip-player"
license=('MIT')
depends=('gtk3' 'nss' 'alsa-lib')
optdepends=('mpd: 本地音频解码与流媒体播放后台服务')
provides=('lpip-player')
conflicts=('lpip-player')
options=('!strip')

package() {
  local _root="$startdir/.."
  local _appdir="$pkgdir/usr/lib/$pkgname"

  # 1. 安装主程序与 Electron 运行环境
  install -dm755 "$_appdir"
  cp -a "$_root/node_modules/electron/dist/"* "$_appdir/"
  mv "$_appdir/electron" "$_appdir/$pkgname"
  chmod 755 "$_appdir/$pkgname"

  # 2. 打包与安装 app.asar
  install -dm755 "$_appdir/resources"
  local _staging="$srcdir/app_staging"
  rm -rf "$_staging"
  mkdir -p "$_staging"
  cp -a "$_root/out" "$_staging/"
  cp -a "$_root/resources" "$_staging/"
  cat << 'PKGJSON' > "$_staging/package.json"
{
  "name": "lpip-player",
  "version": "0.0.1",
  "description": "本地音乐播放器: Electron + React + MPD, 液态玻璃 UI",
  "main": "./out/main/index.js",
  "private": true
}
PKGJSON

  pnpm dlx @electron/asar pack "$_staging" "$_appdir/resources/app.asar"
  chmod 644 "$_appdir/resources/app.asar"

  # 3. 安装可执行文件启动器包装脚本
  install -dm755 "$pkgdir/usr/bin"
  cat << 'LAUNCHER' > "$pkgdir/usr/bin/$pkgname"
#!/usr/bin/env sh
exec /usr/lib/lpip-player/lpip-player "$@"
LAUNCHER
  chmod 755 "$pkgdir/usr/bin/$pkgname"

  # 4. 安装桌面快捷方式
  install -Dm644 "$startdir/lpip-player.desktop" "$pkgdir/usr/share/applications/$pkgname.desktop"

  # 5. 安装各分辨率图标
  for _size in 16 32 48 64 128 256 512 1024; do
    if [ -f "$_root/resources/icon-${_size}.png" ]; then
      install -Dm644 "$_root/resources/icon-${_size}.png" \
        "$pkgdir/usr/share/icons/hicolor/${_size}x${_size}/apps/$pkgname.png"
    fi
  done
  install -Dm644 "$_root/resources/icon.png" "$pkgdir/usr/share/pixmaps/$pkgname.png"
}
