{
  // 窗口形态与外观配置
  "window": {
    // 沉浸式效果开关: true 为无系统边框/无标题栏, false 为常规系统窗口
    "immersive": false,
    // 主窗口云母效果 (Mica Effect): 支持布尔值简写 (true/false) 或下列微调对象
    "mica": {
      // 云母材质总开关
      "enabled": false,
      // 微光色温风格: "default"(经典青绿冷紫) | "cool"(冷夜蓝) | "neutral"(素雅灰) | "warm"(微暖炭黑)
      "style": "default",
      // 矿物颗粒强弱 (0.0 ~ 0.1): 数值越大哑光磨砂感越强, 数值越小越接近精磨玉石
      "grainOpacity": 0.035,
      // 环境微光漫射强度 (0.0 ~ 0.2): 控制云母内部环境光的呼吸感
      "tintOpacity": 0.05,
      // 顶部内高光棱线强度 (0.0 ~ 0.2): 刻画窗口顶部的实体石板微反光边界
      "edgeHighlight": 0.08,
      // 全周边框微弱轮廓: 是否在窗口外周增加 1px 的极细暗微边框
      "border": false
    }
  },
  // MPD (Music Player Daemon) 后端连接配置
  "mpd": {
    // 控制协议地址 (TCP 6600 纯文本协议)
    "host": "127.0.0.1",
    // 控制协议端口
    "port": 6600,
    // httpd 音频流输出端口 (浏览器 <audio> 拉流)
    "streamPort": 8000
  }
}
