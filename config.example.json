{
  // 窗口形态与视觉外观配置
  "window": {
    // 沉浸式效果开关:
    // true: 无系统边框/无系统标题栏，纯净深色舞台，不绘制最小化/最大化按钮
    // false: 常规系统窗口，带有系统原生标题栏与窗口控制按钮
    "immersive": false,

    // 主窗口背景效果 (Background Effect):
    // 统一管理主窗口底层材质与视觉呈现，后续将持续扩展更多效果
    "background": {
      // 当前激活的背景效果模式:
      // "default": 纯净黑曜石深色舞台 (默认)
      // "mica": 温润深色云母矿物晶体微光材质
      // "wallpaper": 自定义本地图片壁纸
      "mode": "default",

      // 自定义壁纸微调配置 (当 mode 为 "wallpaper" 时生效)
      "wallpaper": {
        // 本地壁纸图片文件路径 (支持绝对路径或 ~ 开头家目录路径，如 "~/Pictures/wallpaper.png")
        "path": "",

        // 壁纸高斯模糊半径 (单位 px，范围 0 ~ 50，默认 0):
        // 设置为 0 时画面完全清晰锐利；适度模糊 (如 10~25) 能柔化背景杂色，突显后续液态玻璃质感
        "blur": 0,

        // 暗色遮罩层不透明度 (范围 0.0 ~ 1.0，默认 0.5):
        // 压低壁纸亮度，避免浅色或杂乱壁纸反客为主，保证文字清晰与沉浸感
        "overlayOpacity": 0.5,

        // 壁纸缩放填充模式:
        // "cover": 保持宽高比完全填满窗口并裁剪多余边缘 (推荐)
        // "contain": 保持宽高比完整居中容纳在窗口内
        // "fill": 强制拉伸完全填满窗口
        "fit": "cover"
      },

      // 主窗口云母效果微调配置 (当 mode 为 "mica" 时生效)
      "mica": {
        // 微光色温风格预设:
        // "default": 品牌经典翡翠青绿与冷紫蓝交织微光 (推荐)
        // "cool": 纯冷夜蓝与深靛微光 (清冷科技感)
        // "neutral": 素雅黑白灰中性微光 (极简克制)
        // "warm": 微暖玄武岩与木炭色微光 (胶片复古)
        "style": "default",

        // 矿物晶体颗粒度不透明度 (范围 0.0 ~ 0.1，默认 0.035)
        "grainOpacity": 0.035,

        // 环境微光漫射强度 (范围 0.0 ~ 0.2，默认 0.05)
        "tintOpacity": 0.05,

        // 顶部内高光棱线反射强度 (范围 0.0 ~ 0.2，默认 0.08)
        "edgeHighlight": 0.08,

        // 全周边框微弱勾勒轮廓 (true / false)
        "border": false
      }
    }
  },

  // MPD (Music Player Daemon) 后端连接配置
  // 本地服务已开机自启 (systemctl --user status mpd)，无需重复探测
  "mpd": {
    // 控制协议绑定地址 (TCP 6600 纯文本控制流，手写客户端交互)
    "host": "127.0.0.1",

    // 控制协议端口号
    "port": 6600,

    // httpd 音频流输出端口 (浏览器 <audio> 标签取音频流 + WebAudio 频谱分析)
    // 注意: httpd 流为惰性绑定，未播放前不监听，播放时自动建立连接
    "streamPort": 8000
  }
}
