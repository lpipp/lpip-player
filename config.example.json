{
  // 窗口形态与视觉外观配置
  "window": {
    // 沉浸式效果开关:
    // true: 无系统边框/无系统标题栏，纯净深色舞台，不绘制最小化/最大化按钮
    // false: 常规系统窗口，带有系统原生标题栏与窗口控制按钮
    "immersive": false,

    // 主题模式与明暗效果微调配置 (Theme & Brightness Tuning):
    "theme": {
      // 当前主题模式:
      // "dark": 深色黑曜石毛玻璃模式 (默认)
      // "light": 浅色白玉霜雪毛玻璃模式
      "mode": "dark",

      // 明暗度微调偏移量 (范围 -0.2 ~ +0.2，默认 0):
      // 0 为基准平衡；深色模式下负值更深沉幽邃、正值更透亮；浅色模式下正值更透白、负值偏灰银
      "brightness": 0,

      // 对比度微调系数 (范围 0.8 ~ 1.2，默认 1.0):
      // 控制界面文字、边框与底色之间的明暗反差强度
      "contrast": 1.0
    },

    // 主窗口背景效果 (Background Effect):
    // 统一管理主窗口底层材质与视觉呈现，后续将持续扩展更多效果
    "background": {
      // 当前激活的背景效果模式:
      // "default": 纯净黑曜石深色舞台 (默认)
      // "mica": 温润深色云母矿物晶体微光材质
      // "wallpaper": 自定义本地图片壁纸
      "mode": "default",

      // 自定义壁纸微调配置 (当 mode 为 "wallpaper" 时生效，支持本地静态图片与动态视频)
      "wallpaper": {
        // 本地壁纸图片或视频文件路径 (支持绝对路径或 ~ 开头家目录路径):
        // 图片支持: .png, .jpg, .jpeg, .webp, .gif, .bmp, .svg
        // 视频支持: .mp4, .webm, .mkv, .mov, .avi (硬件加速无损流式循环播放)
        // 例如: "~/Movies/live_wallpaper.mp4" 或 "~/Pictures/wallpaper.png"
        "path": "",

        // 壁纸高斯模糊半径 (单位 px，范围 0 ~ 50，默认 0):
        // 设置为 0 时画面完全清晰锐利；适度模糊 (如 10~25) 能柔化背景杂色，突显毛玻璃质感
        "blur": 0,

        // 暗色遮罩层不透明度 (范围 0.0 ~ 1.0，默认 0.5):
        // 压低壁纸亮度，避免浅色或高动态视频反客为主，保证文字清晰与沉浸感
        "overlayOpacity": 0.5,

        // 缩放填充模式:
        // "cover": 保持宽高比完全填满窗口并裁剪多余边缘 (推荐)
        // "contain": 保持宽高比完整居中容纳在窗口内
        // "fill": 强制拉伸完全填满窗口
        "fit": "cover",

        // 视频壁纸专属配置 (对静态图片无效):
        // 是否静音播放 (默认 true，避免视频自身音轨与音乐播放冲突)
        "muted": true,

        // 是否循环播放 (默认 true)
        "loop": true,

        // 视频播放速率 (范围 0.25 ~ 2.0，默认 1.0)
        "playbackRate": 1.0
      },

      // 主窗口云母效果微调配置 (当 mode 为 "mica" 时生效)
      "mica": {
        // 微光色温风格预设:
        // "default": 品牌经典翡翠青绿与冷紫蓝交织微光 (推荐)
        // "cool": 纯冷夜蓝与深靛微光 (清冷科技感)
        // "neutral": 素雅黑白灰中性微光 (极简克制)
        // "warm": 微暖玄武岩与木炭色微光 (胶片复古)
        "style": "default",

        // 矿物晶体颗粒度不透明度 (范围 0.0 ~ 0.1，默认 0.035)
        "grainOpacity": 0.035,

        // 环境微光漫射强度 (范围 0.0 ~ 0.2，默认 0.05)
        "tintOpacity": 0.05,

        // 顶部内高光棱线反射强度 (范围 0.0 ~ 0.2，默认 0.08)
        "edgeHighlight": 0.08,

        // 全周边框微弱勾勒轮廓 (true / false)
        "border": false
      }
    },

    // 左侧悬浮长条胶囊伸缩抽屉配置
    // 窗口左侧悬浮长条形胶囊展示图标，点击图标向右伸展为抽屉并直接显示对应子菜单，鼠标移出指定距离后延时收起
    "sidebar": {
      // 侧边栏总开关 (true: 启用, false: 禁用)
      "enabled": true,

      // 移出抽屉的安全触发关闭距离/缓冲范围 (单位 px，范围 0 ~ 200，默认 40，支持别名 closeDistance):
      // 抽屉展开后，鼠标超出抽屉此距离仍保持开启，超出后才触发关闭延迟，交互手感从容不误关
      "closeBuffer": 40,

      // 鼠标移出超出关闭距离后的自动收起延迟 (单位 ms，范围 0 ~ 3000，默认 300):
      // 鼠标超出关闭范围后等待该时间才收起，期间若移回安全距离内则自动取消收起
      "closeDelay": 300,

      // 滑出/收起动画过渡时长 (单位 ms，范围 100 ~ 1000，默认 280):
      // 控制胶囊向右伸长与缩回动画的速度，数值越小越敏捷，数值越大越沉稳
      "animationDuration": 280,

      // 动画缓动函数 (如 "ease", "cubic-bezier(0.16, 1, 0.3, 1)"):
      // 控制伸展动画的加速度曲线
      "animationEasing": "cubic-bezier(0.16, 1, 0.3, 1)",

      // 抽屉伸长展开后的宽度 (单位 px，范围 160 ~ 600，默认 460)
      "width": 460,

      // 抽屉展开时上下各延伸的像素幅度 (单位 px，范围 0 ~ 200，默认 50，支持别名 verticalExpansion):
      // 展开时顶部向上 +50px，底部向下 +50px，配合横向向右伸长，形成自然舒展的二维展开形态
      "verticalExtension": 50,

      // 悬浮胶囊与伸缩抽屉毛玻璃背景不透明度 (范围 0.0 ~ 1.0，默认 0.78):
      // 数值越小背景越通透，能更清晰透出后方动态壁纸；推荐 0.25 ~ 0.5 获得通透灵动感
      "opacity": 0.3
    }
  },

  // 音频播放与音效过渡配置 (Audio & Transition Effects):
  "audio": {
    // 切歌与歌词跳转时的淡出淡入过渡配置 (Crossfade / Fade Transition)
    "fade": {
      // 开关: 是否启用切歌与歌词跳转时的平滑淡出淡入 (true: 开启, false: 瞬时硬切)
      "enabled": true,

      // 淡入淡出过渡时长 (单位 ms，范围 20 ~ 1000，推荐 80 ~ 200，默认 120):
      // 切歌或跳转歌词时，上一段音频以该时长线性淡出，新音频以该时长平滑淡入，完全杜绝爆音与突兀截断感
      "duration": 120
    },

    // 歌词滚轮预览确认延迟配置 (Lyric Wheel Preview Confirm Timeout):
    "lyricPreview": {
      // 滚轮预览后等待单击确认的超时时长 (单位 ms，范围 500 ~ 5000，默认 1500):
      // 滚轮滚动歌词只进入预览态 (轨道跟随预览行)，需在该时长内左键单击任意行确认跳转；
      // 播放态超时未点击则自动回弹至当前播放行，暂停态预览常驻直到单击确认 (确认跳转将自动恢复播放)
      "timeoutMs": 1500
    }
  },

  // 音频频谱可视化律动配置 (Spectrum Visualizer):
  "visualizer": {
    // 频谱开关: true 启用频谱动效, false 彻底休眠 RAF 循环并隐藏画布
    "enabled": true,

    // 频谱画布高度 (单位 px, 范围 40 ~ 600, 推荐 120 ~ 240, 默认 160)
    "height": 160,

    // 可视化整体不透明度 (范围 0.0 ~ 1.0, 默认 0.85)
    "opacity": 0.85,

    // 视觉渲染风格:
    // "blueprint": 高级制表纯线条蓝图工程风 + 散点粒子微光 (推荐, 默认)
    // "wave": 极细高频工程波形正弦包络线
    // "bars": 精密制表刻度柱状频段
    "style": "blueprint"
  },

  // MPD (Music Player Daemon) 后端连接配置
  // 本地服务已开机自启 (systemctl --user status mpd)，无需重复探测
  "mpd": {
    // 控制协议绑定地址 (TCP 6600 纯文本控制流，手写客户端交互)
    "host": "127.0.0.1",

    // 控制协议端口号
    "port": 6600,

    // httpd 音频流输出端口 (浏览器 <audio> 标签取音频流 + WebAudio 频谱分析)
    // 注意: httpd 流为惰性绑定，未播放前不监听，播放时自动建立连接
    "streamPort": 8000
  },

  // 全局文字排印与字体系统配置 (Typography & Font System)
  // 支持自主配置 UI 界面、辅助提示以及星盘歌词 (正文与翻译) 的字形 (font-family) 与字号 (font-size)
  // 配置支持秒级热重载生效，并通过 CSS 变量实时驱动全局文字呈现
  "typography": {
    // 界面通用字体 (控制主工作区、状态栏曲目名、抽屉导航列表等)
    "ui": {
      // 字体族名称 (支持推荐优质字体族或自定义字体名，留空则使用系统默认字体栈)
      "fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"PingFang SC\", \"Microsoft YaHei\", sans-serif",
      // 界面基准字号 (单位 px, 范围 12 ~ 20, 默认 13)
      "fontSize": 13
    },

    // 提示与辅助文本 (控制等宽播放时间、SQ/Hi-Res 音质徽标、歌手专辑副标题等较小字阶)
    "hint": {
      // 字体族名称 (推荐等宽或精密工程字体栈)
      "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"JetBrains Mono\", monospace",
      // 辅助提示基准字号 (单位 px, 范围 12 ~ 16, 默认 12)
      "fontSize": 12
    },

    // 歌词文本配置 (含正文与翻译独立调节)
    "lyrics": {
      // 歌词正文大号高亮字形配置
      "body": {
        // 歌词正文字体族名称 (推荐史诗衬线、文艺楷体或现代黑体)
        "fontFamily": "'Playfair Display', 'DejaVu Serif', 'Liberation Serif', 'Noto Serif CJK SC', 'Noto Serif SC', 'Source Han Serif SC', Georgia, serif",
        // 歌词正文基准字号 (单位 px, 范围 14 ~ 36, 默认 18)
        "fontSize": 18
      },

      // 是否显示歌词翻译行 (true: 显示译文, false: 隐藏全部 .lyric-secondary, 默认 true)
      "showTranslation": true,

      // 歌词翻译/次级辅助字形配置
      "translation": {
        // 歌词翻译字体族名称 (推荐清晰易读的无衬线黑体或文艺楷体)
        "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif",
        // 歌词翻译基准字号 (单位 px, 范围 12 ~ 22, 默认 12)
        "fontSize": 12
      }
    }
  }
}

